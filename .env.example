# copy to .env

# RSS feeds (comma-separated)
RSS_FEEDS=https://openai.com/blog/rss.xml,https://www.anthropic.com/news/rss.xml,https://blog.google/technology/ai/rss/,https://blog.google/technology/developers/rss/,https://huggingface.co/blog/feed.xml
RSS_INCLUDE_KEYWORDS=llm,agent,openclaw,codex,desktop,client,gui,ui,dashboard,visualization,visualisation,tool,tools,studio,app,workflow,assistant
RSS_EXCLUDE_KEYWORDS=
RSS_REQUEST_TIMEOUT=15
RSS_PER_FEED_LIMIT=50

# GitHub (optional, for higher rate limits)
GITHUB_TOKEN=
GITHUB_DEBUG=false
GITHUB_MIN_STARS=1000
GITHUB_EXCLUDE_KEYWORDS=course,homework,assignment,lecture,slides,notes,syllabus,curriculum,class,school,internship,task,lab,project,introduction,academic,courseware,课程,作业,课件,讲义,笔记,试卷,习题,课堂

# GitHub search
GITHUB_SEARCH_QUERY=llm OR ai
GITHUB_SEARCH_QUALIFIERS=
GITHUB_SEARCH_DAYS=30
GITHUB_SEARCH_PER_PAGE=20

# WeCom group robot webhook (markdown)
WECOM_WEBHOOK=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
